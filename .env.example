# Copy to .env and fill in. .env is gitignored; never commit real values.

# Salesforce External Client App (OAuth 2.0 Client Credentials flow)
# My Domain host only, no https:// (Setup > My Domain), e.g. yourname-dev-ed.develop.my.salesforce.com
SF_DOMAIN=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=64.0

# Salesforce CLI alias used by scripts/seed_salesforce.py (runs as your admin user, not the agent)
SF_ADMIN_ALIAS=dealdesk-admin

ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5-5
DRY_RUN=true

# Optional: use BigQuery instead of local JSONL for the audit log and review queue
GCP_PROJECT=
BQ_DATASET=

# Review API (uvicorn deal_desk.api:app): bearer token and the name recorded as approver
REVIEW_API_TOKEN=
REVIEWER_NAME=

# MCP server: create_task is disabled unless this is true
MCP_ALLOW_WRITES=false
