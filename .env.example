# Copy to .env and fill in. .env is gitignored; never commit real values.

# Salesforce External Client App (OAuth 2.0 Client Credentials flow)
# My Domain host only, no https:// (Setup > My Domain), e.g. yourname-dev-ed.develop.my.salesforce.com
SF_DOMAIN=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=64.0

# Salesforce CLI alias used by scripts/seed_salesforce.py (runs as your admin user, not the agent)
SF_ADMIN_ALIAS=dealdesk-admin
